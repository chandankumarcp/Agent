# AgentRouter API key — get yours at https://agentrouter.ai
AGENTROUTER_API_KEY=your_api_key_here

# AgentRouter base URL (change only if using a self-hosted instance)
AGENTROUTER_BASE_URL=https://agentrouter.org

# Model to use via AgentRouter (e.g. gpt-4o, claude-3-5-sonnet, gemini-1.5-pro)
AGENTROUTER_MODEL=gpt-5.6-sol
